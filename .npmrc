# 本项目源自内网，package-lock.json 中的 resolved 原本指向 registry.anpm.alibaba-inc.com，
# 该地址在公网不可达。此处统一切换到公网可用的 npmmirror 镜像。

registry=https://registry.npmmirror.com

# 兜底：即使 lockfile 里残留了其它 registry 的 resolved 地址，也强制改写 host 为上面的 registry。
# 默认值 npmjs 只会改写 registry.npmjs.org，覆盖不到内网源。
replace-registry-host=always

# Electron 二进制与 electron-builder 打包依赖同样走镜像，避免从 GitHub 拉取上百 MB。
electron_mirror=https://cdn.npmmirror.com/binaries/electron/
electron_builder_binaries_mirror=https://cdn.npmmirror.com/binaries/electron-builder-binaries/
